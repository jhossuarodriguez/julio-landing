---
import Icon, { type IconName } from "@/components/ui/Icon.astro";
import { BOOKING_HREF } from "@/config/site";

const services: { icon: IconName; title: string; text: string; accent: string }[] = [
  {
    icon: "psi",
    title: "Terapia individual",
    text: "Procesos para conocerte mejor, fortalecer tus recursos y construir la vida que deseas.",
    accent: "bg-sage/25 text-forest",
  },
  {
    icon: "heart",
    title: "Terapia de pareja",
    text: "Herramientas para mejorar la comunicación, resolver conflictos y fortalecer el vínculo.",
    accent: "bg-apricot/20 text-terracotta",
  },
  {
    icon: "flame",
    title: "Terapia sexual",
    text: "Un espacio confiable para acompañarte a superar e integrar tus preocupaciones relacionadas con tu sexualidad, en pareja o de forma individual.",
    accent: "bg-terracotta/15 text-clay",
  },
];---

<section id="servicios" class="bg-white/55 py-24 sm:py-32">
  <div class="container-page">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow text-terracotta">Servicios</p>
      <h2 class="mt-5 font-display text-4xl leading-tight text-forest sm:text-5xl">¿Cómo puedo ayudarte?</h2>
      <p class="mt-5 leading-relaxed font-light text-forest/75">
        Acompañamiento individual y de pareja para adultos que buscan sentirse mejor y vivir con mayor bienestar
        emocional.
      </p>
    </div>

    <div class="mx-auto mt-16 grid max-w-5xl gap-5 md:grid-cols-3">
      {
        services.map((s) => (
          <article class="reveal group flex flex-col rounded-3xl border border-forest/10 bg-linen p-7 transition duration-300 ease-out hover:-translate-y-1 hover:shadow-xl hover:shadow-forest/10">
            <span class:list={["inline-flex size-14 items-center justify-center rounded-2xl", s.accent]}>
              <Icon name={s.icon} class="size-7" />
            </span>
            <h3 class="mt-6 font-display text-2xl text-forest">{s.title}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-forest/75">{s.text}</p>
          </article>
        ))
      }
    </div>

    <div class="reveal mt-14 text-center">
      <a href={BOOKING_HREF} class="btn-outline-dark px-8">
        Agenda tu cita
        <Icon name="arrow" class="size-4" />
      </a>
    </div>
  </div>
</section>
