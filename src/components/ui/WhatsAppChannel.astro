---
/**
 * Botón fijo "Únete a nuestro canal" (canal de WhatsApp).
 * Usa los verdes de la marca en lugar del verde de WhatsApp y queda por encima de todo (z-[100]).
 */
import Icon from "@/components/ui/Icon.astro";
import { site } from "@/config/site";
---

<a
  href={site.social.whatsappChannel}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Únete a nuestro canal de WhatsApp (se abre en una pestaña nueva)"
  class="group fixed bottom-4 left-4 z-[100] inline-flex items-center gap-2.5 rounded-full bg-forest py-1.5 pr-4 pl-1.5 text-linen shadow-2xl ring-1 shadow-forest-900/40 ring-cream/30 transition duration-300 ease-out hover:-translate-y-0.5 hover:bg-forest-800 hover:ring-sage sm:bottom-6 sm:left-6 sm:gap-3 sm:pr-5"
>
  <span
    class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-sage text-forest-900 transition duration-300 ease-out group-hover:scale-105 sm:size-11"
  >
    <Icon name="whatsapp" class="size-5 sm:size-6" />
  </span>
  <span class="flex flex-col text-left leading-tight">
    <span class="text-[0.625rem] tracking-[0.2em] text-sage uppercase">Canal de WhatsApp</span>
    <span class="text-sm font-medium whitespace-nowrap">Únete a nuestro canal</span>
  </span>
</a>
