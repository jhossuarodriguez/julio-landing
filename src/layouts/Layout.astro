---
import "@fontsource/gilda-display/400.css";
import "@fontsource/poppins/300.css";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@/styles/global.css";
import { site } from "@/config/site";
import { buildJsonLd } from "@/lib/schema";
import { getArticles } from "@/lib/medium";
// Fuente de los titulares (H1 = LCP): se precarga para no retrasar el primer pintado
import gildaWoff2 from "@fontsource/gilda-display/files/gilda-display-latin-400-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  /** Imagen para compartir (ruta del sitio, JPG). Por defecto la general de 1200×630 */
  ogImage?: string;
  /** Tamaño de `ogImage` si no es la general */
  ogImageSize?: { width: number; height: number };
  /** Texto alternativo de `ogImage` */
  ogImageAlt?: string;
  /** Datos de artículo (og:type="article") */
  article?: { publishedTime: string; modifiedTime?: string };
  /** Excluir de buscadores (p. ej. la página 404) */
  noindex?: boolean;
  /** Nodos JSON-LD adicionales de la página (se añaden al @graph común) */
  schema?: Record<string, unknown>[];
  /** @id de la entidad principal de la página (p. ej. su Service) */
  mainEntityId?: string;
  /** @id del BreadcrumbList de la página */
  breadcrumbId?: string;
  /** Última revisión del contenido (AAAA-MM-DD); por defecto, la de la home */
  dateModified?: string;
}

const {
  title = site.title,
  description = site.description,
  ogImage = "/og-image.jpg",
  ogImageSize = { width: 1200, height: 630 },
  ogImageAlt: ogImageAltProp,
  article,
  noindex = false,
  schema = [],
  mainEntityId,
  breadcrumbId,
  dateModified = site.contentUpdated,
} = Astro.props;

// URLs absolutas: solo existen cuando `site` (SITE_URL) está configurado en astro.config.mjs
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : null;
const ogImageUrl = abs(ogImage);
const ogImageAlt = ogImageAltProp ?? `${site.name}, ${site.role.toLowerCase()} en Santo Domingo`;

// Datos estructurados generados desde los mismos datos que muestra la página
const articles = await getArticles();
// Retrato de Julio con URL fija (public/), para que no cambie en cada build
const jsonLd = buildJsonLd({
  abs,
  pageUrl: canonical ?? abs(Astro.url.pathname),
  pageTitle: title,
  imageUrl: ogImageUrl,
  personImageUrl: abs("/julio-cesar-sanchez.jpg"),
  mainEntityId,
  breadcrumbId,
  dateModified: noindex ? undefined : dateModified,
  articles,
});
jsonLd["@graph"].push(...(schema as any[]));
---

<!doctype html>
<html lang="es" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#3f4537" />
    <link rel="preload" href={gildaWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={article ? "article" : "website"} />
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    {article && <meta property="article:modified_time" content={article.modifiedTime ?? article.publishedTime} />}
    {article && <meta property="article:author" content={abs("/#sobre-mi")} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(ogImageSize.width)} />
    <meta property="og:image:height" content={String(ogImageSize.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      document.documentElement.classList.remove("no-js");
    </script>
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-full focus:bg-linen focus:px-4 focus:py-2 focus:text-forest"
    >
      Saltar al contenido
    </a>
    <slot />

    <script>
      // Aparición suave de las secciones al entrar en pantalla
      const items = document.querySelectorAll<HTMLElement>(".reveal");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
