---
/**
 * Página de cada artículo de Julio: /articulos/<slug>/
 * El contenido viene de Medium (feed + archivo local) y es la versión canónica:
 * en Medium, cada historia debe apuntar aquí con "Customize canonical link".
 */
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import Booking from "@/components/sections/Booking.astro";
import FloatingBooking from "@/components/ui/FloatingBooking.astro";
import BgTexture from "@/components/ui/BgTexture.astro";
import Icon from "@/components/ui/Icon.astro";
import { site, credentials } from "@/config/site";
import { getArticles, articlePath, type Article } from "@/lib/medium";
import { splitArticle, relatedService, fmtDate } from "@/lib/articulo";
import retrato from "@/assets/images/julio-retrato.png";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((a) => ({ params: { slug: a.slug }, props: { article: a } }));
}

const { article } = Astro.props as { article: Article };
const { parts, cover } = await splitArticle(article.html);
const service = relatedService(article);
const firstImage = parts.findIndex((p) => p.type === "img");
const others = (await getArticles()).filter((a) => a.id !== article.id).slice(0, 3);

// Datos estructurados: BlogPosting + migas
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const path = articlePath(article);
const postingId = abs(`${path}#articulo`);
const breadcrumbId = abs(`${path}#migas`);
const words = article.html.replace(/<[^>]+>/g, " ").split(/\s+/).filter(Boolean).length;
const schema = [
  {
    "@type": "BlogPosting",
    "@id": postingId,
    headline: article.title,
    description: article.excerpt,
    url: abs(path),
    mainEntityOfPage: abs(path),
    datePublished: article.date,
    dateModified: article.date,
    inLanguage: "es",
    wordCount: words,
    author: { "@id": abs("/#persona") },
    publisher: { "@id": abs("/#persona") },
    isPartOf: { "@id": abs("/articulos/#blog") },
    ...(cover ? { image: abs(cover) } : {}),
    keywords: article.categories.join(", "),
    sameAs: article.url,
  },
  {
    "@type": "BreadcrumbList",
    "@id": breadcrumbId,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: abs("/") },
      { "@type": "ListItem", position: 2, name: "Artículos", item: abs("/articulos/") },
      { "@type": "ListItem", position: 3, name: article.title, item: abs(path) },
    ],
  },
];
---

<Layout
  title={`${article.title} · Julio Sánchez`}
  description={article.excerpt}
  schema={schema}
  mainEntityId={postingId}
  breadcrumbId={breadcrumbId}
  dateModified={article.date.slice(0, 10)}
>
  <Header bookingHref="#agenda" />
  <main id="contenido">
    <section class="relative isolate overflow-hidden bg-forest text-linen">
      <BgTexture class="-z-10" eager lowPriority={false} />
      <div class="container-page max-w-3xl pt-32 pb-14 md:pt-36">
        <nav aria-label="Migas de pan" class="text-sm text-cream/75">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/" class="inline-flex min-h-11 items-center hover:text-linen">Inicio</a></li>
            <li aria-hidden="true">›</li>
            <li><a href="/articulos/" class="inline-flex min-h-11 items-center hover:text-linen">Artículos</a></li>
          </ol>
        </nav>
        <h1 class="mt-4 font-display text-4xl leading-tight text-cream sm:text-5xl">{article.title}</h1>
        <p class="mt-6 text-sm text-linen/85">
          Por <a href="/#sobre-mi" class="font-medium text-cream underline underline-offset-2 hover:text-linen">{site.name}</a>{
            `, ${site.role.toLowerCase()} · `
          }<time datetime={article.date}>{fmtDate(article.date)}</time>{` · ${article.readingMinutes} min de lectura`}
        </p>
      </div>
    </section>

    <article class="py-14 sm:py-20">
      <div class="container-page max-w-3xl">
        <div class="prose-articulo">
          {
            parts.map((p, i) =>
              p.type === "html" ? (
                <Fragment set:html={p.html} />
              ) : (
                <Image
                  src={p.img.src}
                  width={p.img.width}
                  height={p.img.height}
                  alt={p.img.alt}
                  format="avif"
                  widths={[...new Set([400, 640, 960].map((w) => Math.min(w, p.img.width)))]}
                  sizes="(min-width: 48rem) 45rem, calc(100vw - 2.5rem)"
                  loading={i === firstImage ? "eager" : "lazy"}
                  fetchpriority={i === firstImage ? "high" : undefined}
                />
              ),
            )
          }
        </div>

        <!-- Autor -->
        <div class="mt-16 flex flex-col gap-5 rounded-3xl border border-forest/10 bg-white/60 p-6 sm:flex-row sm:items-center sm:p-8">
          <Image
            src={retrato}
            alt={`Retrato de ${site.name}`}
            width={160}
            format="avif"
            class="size-20 shrink-0 rounded-full object-cover object-top"
          />
          <div>
            <p class="font-display text-2xl text-forest">{site.name}</p>
            <p class="mt-1 text-sm leading-relaxed text-forest/85">
              Psicólogo clínico y psicoterapeuta familiar y de pareja desde {credentials.practiceSince} en Santo Domingo ·
              Exequátur {credentials.exequatur} · CODOPSI {credentials.codopsi}
            </p>
            <a href="/#sobre-mi" class="mt-1 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-forest hover:text-terracotta-700">
              Formación y enfoque
              <Icon name="arrow" class="size-4" />
            </a>
          </div>
        </div>

        <!-- Servicio relacionado -->
        <div class="mt-6 rounded-3xl bg-sage/20 p-6 sm:p-8">
          <p class="eyebrow text-terracotta-700">¿Te identificas con esto?</p>
          <p class="mt-3 font-display text-2xl text-forest">{service.title}</p>
          <p class="mt-2 leading-relaxed text-forest/85">{service.text}</p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <a href="#agenda" class="btn-primary px-7">
              <Icon name="calendar" class="size-4" />
              Agenda tu cita
            </a>
            <a href={service.path} class="btn-outline-dark px-7">
              Saber más sobre {service.title.toLowerCase()}
              <Icon name="arrow" class="size-4" />
            </a>
          </div>
        </div>
      </div>
    </article>

    {
      others.length > 0 && (
        <section class="bg-white/55 py-16 sm:py-20" aria-labelledby="mas-articulos">
          <div class="container-page">
            <h2 id="mas-articulos" class="font-display text-3xl text-forest">Más artículos</h2>
            <ul class="mt-8 grid gap-5 md:grid-cols-3">
              {others.map((o) => (
                <li>
                  <a
                    href={articlePath(o)}
                    class="group flex h-full flex-col rounded-3xl border border-forest/10 bg-linen p-6 transition duration-300 ease-out hover:-translate-y-1 hover:shadow-xl hover:shadow-forest/10"
                  >
                    <span class="text-xs tracking-[0.2em] text-olive uppercase">
                      <time datetime={o.date}>{fmtDate(o.date, "short")}</time> · {o.readingMinutes} min
                    </span>{" "}
                    <span class="mt-2 font-display text-xl leading-snug text-forest group-hover:text-terracotta-700">{o.title}</span>{" "}
                    <span class="mt-2 line-clamp-3 text-sm leading-relaxed text-forest/85">{o.excerpt}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a href="/articulos/" class="btn-outline-dark mt-8 px-7">
              Ver todos los artículos
              <Icon name="arrow" class="size-4" />
            </a>
          </div>
        </section>
      )
    }

    <Booking />
  </main>
  <Footer />
  <FloatingBooking href="#agenda" />
</Layout>
