---
/**
 * Páginas de servicio: /terapia-sexual/, /terapia-de-pareja/, /terapia-individual/.
 * El contenido vive en @/data/servicios; las rutas, en @/config/site (services[].path).
 */
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import Booking from "@/components/sections/Booking.astro";
import FloatingBooking from "@/components/ui/FloatingBooking.astro";
import WhatsAppChannel from "@/components/ui/WhatsAppChannel.astro";
import BgTexture from "@/components/ui/BgTexture.astro";
import Icon from "@/components/ui/Icon.astro";
import { services, credentials, site, type ServiceSlug } from "@/config/site";
import { servicePages } from "@/data/servicios";
import { getArticles, ARTICLES_SHOWN } from "@/lib/medium";
import julioDePie from "@/assets/images/julio-de-pie.png";
import julioSonrisa from "@/assets/images/julio-sonrisa.png";
import julioBn from "@/assets/images/julio-bn.png";
import julioSentado from "@/assets/images/julio-sentado.png";

export function getStaticPaths() {
  return services.map((s) => ({
    params: { servicio: s.path.replaceAll("/", "") },
    props: { slug: s.slug },
  }));
}

const { slug } = Astro.props as { slug: ServiceSlug };
const page = servicePages[slug];
const service = services.find((s) => s.slug === slug)!;
const others = services.filter((s) => s.slug !== slug);
const images = { "julio-de-pie": julioDePie, "julio-sonrisa": julioSonrisa, "julio-bn": julioBn, "julio-sentado": julioSentado };
const relevant = credentials.education.filter((e) => page.relevantCredentials.includes(e.title));
const articles = page.showArticles ? (await getArticles()).slice(0, ARTICLES_SHOWN) : [];

const fmtDate = (iso: string) =>
  new Intl.DateTimeFormat("es-DO", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "America/Santo_Domingo",
  }).format(new Date(iso));

// Datos estructurados de la página: el servicio y las migas de pan
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const serviceId = abs(`${service.path}#servicio`);
const breadcrumbId = abs(`${service.path}#migas`);
const santoDomingo = {
  "@type": "City",
  name: "Santo Domingo",
  containedInPlace: { "@type": "Country", name: "República Dominicana" },
};
const schema = [
  {
    "@type": "Service",
    "@id": serviceId,
    name: service.title,
    serviceType: "Psicoterapia",
    description: page.description,
    url: abs(service.path),
    provider: { "@id": abs("/#persona") },
    areaServed: santoDomingo,
  },
  {
    "@type": "BreadcrumbList",
    "@id": breadcrumbId,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: abs("/") },
      { "@type": "ListItem", position: 2, name: service.title, item: abs(service.path) },
    ],
  },
];
---

<Layout
  title={page.seoTitle}
  description={page.description}
  schema={schema}
  mainEntityId={serviceId}
  breadcrumbId={breadcrumbId}
  dateModified={page.updated}
>
  <Header bookingHref="#agenda" />
  <main id="contenido">
    <!-- Encabezado -->
    <section class="relative isolate overflow-hidden bg-forest text-linen">
      <BgTexture class="-z-20" eager lowPriority={false} />
      <div
        class="container-page grid items-center gap-12 pt-32 pb-16 md:pt-36 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16 lg:pb-24"
      >
        <div class="reveal">
          <nav aria-label="Migas de pan" class="text-sm text-cream/75">
            <ol class="flex flex-wrap items-center gap-2">
              <li><a href="/" class="inline-flex min-h-11 items-center hover:text-linen">Inicio</a></li>
              <li aria-hidden="true">›</li>
              <li aria-current="page" class="text-cream">{service.title}</li>
            </ol>
          </nav>
          <h1 class="mt-4">
            <span class="eyebrow block leading-relaxed tracking-[0.22em] text-sage-300">
              {site.role} · Presencial y online
            </span>
            {" "}
            <span class="mt-5 block font-display text-[2.5rem] leading-[1.08] text-cream sm:text-5xl lg:text-6xl">
              {page.h1}
            </span>
          </h1>
          <p class="mt-6 max-w-xl text-base leading-relaxed font-light text-linen/85 sm:text-lg">{page.lead}</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href="#agenda" class="btn-primary px-8 py-3.5 text-base">
              <Icon name="calendar" class="size-5" />
              Agenda tu cita
            </a>
            <a href="#preguntas" class="btn-outline-light px-8 py-3.5 text-base">Preguntas frecuentes</a>
          </div>
        </div>
        <div class="reveal relative mx-auto hidden w-full max-w-xs lg:block">
          <div class="absolute -inset-3 rounded-t-full border border-cream/25" aria-hidden="true"></div>
          <div class="relative overflow-hidden rounded-t-full bg-sage/30 shadow-2xl shadow-forest-900/40">
            <Image
              format="avif"
              src={images[page.image]}
              alt={page.imageAlt}
              widths={[320, 480, 683]}
              sizes="20rem"
              class="aspect-[4/5] h-auto w-full object-cover object-top"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Cuándo puede ayudarte -->
    <section class="py-20 sm:py-28">
      <div class="container-page grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="reveal">
          <p class="eyebrow text-terracotta-700">¿Cuándo puede ayudarte?</p>
          <h2 class="mt-5 font-display text-3xl leading-tight text-forest sm:text-4xl">
            Motivos frecuentes de consulta
          </h2>
          <p class="mt-6 leading-relaxed font-light text-forest/80">{page.whenIntro}</p>
        </div>
        <ul class="reveal grid gap-3">
          {
            page.when.map((item) => (
              <li class="flex items-start gap-4 rounded-2xl border border-forest/10 bg-white/60 px-5 py-4">
                <Icon name="check" class="mt-0.5 size-5 shrink-0 text-terracotta-700" strokeWidth={2} />
                <span class="leading-relaxed text-forest/85">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Cómo trabajo -->
    <section class="bg-white/55 py-20 sm:py-28">
      <div class="container-page grid gap-12 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="reveal">
          <p class="eyebrow text-terracotta-700">Cómo trabajo</p>
          <h2 class="mt-5 font-display text-3xl leading-tight text-forest sm:text-4xl">
            Enfoque sistémico breve, orientado a soluciones
          </h2>
          <!-- Párrafos (no <blockquote>/<figure>) para que los extractores de IA incluyan este texto -->
          <div class="mt-6 border-l-2 border-terracotta-700 pl-5">
            <p class="font-display text-xl leading-relaxed text-forest sm:text-2xl">{page.practice}</p>
            <p class="mt-3 text-sm text-forest/85">— {site.name}, {site.role.toLowerCase()}</p>
          </div>
          <div class="mt-6 space-y-5 leading-relaxed font-light text-forest/85">
            {page.approach.map((p) => <p>{p}</p>)}
          </div>
        </div>
        <aside class="reveal self-start rounded-[2rem] bg-forest p-7 text-linen sm:p-9" aria-label="Formación relacionada">
          <p class="eyebrow text-sage-300">Formación relacionada</p>
          <p class="mt-4 font-display text-2xl text-cream">{site.name}</p>
          <ul class="mt-6 space-y-4">
            {
              relevant.map((e) => (
                <li class="flex gap-3">
                  <Icon name="graduation" class="mt-0.5 size-5 shrink-0 text-sage" />
                  <span>
                    <span class="block leading-snug">{e.title}</span>
                    <span class="mt-0.5 block text-sm text-linen/70">{"short" in e && e.short ? e.short : e.institution}</span>
                  </span>
                </li>
              ))
            }
          </ul>
          <p class="mt-6 flex flex-wrap gap-x-4 gap-y-1 border-t border-linen/15 pt-5 text-sm text-linen/80">
            <span>Exequátur {credentials.exequatur}</span>
            <span>CODOPSI {credentials.codopsi}</span>
          </p>
          <a href="/#sobre-mi" class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-apricot-300 hover:text-linen">
            Ver formación completa
            <Icon name="arrow" class="size-4" />
          </a>
        </aside>
      </div>
    </section>

    <!-- Proceso -->
    <section class="py-20 sm:py-28">
      <div class="container-page">
        <div class="reveal max-w-2xl">
          <p class="eyebrow text-terracotta-700">Paso a paso</p>
          <h2 class="mt-5 font-display text-3xl leading-tight text-forest sm:text-4xl">Cómo es el proceso</h2>
        </div>
        <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {
            page.steps.map((s, i) => (
              <li class="reveal rounded-3xl border border-forest/10 bg-white/60 p-6">
                <span class="font-display text-3xl text-apricot">{String(i + 1).padStart(2, "0")}</span>
                <h3 class="mt-3 font-medium text-forest">{s.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-forest/85">{s.text}</p>
              </li>
            ))
          }
        </ol>

        <div class="reveal mt-10 flex flex-col gap-4 rounded-3xl bg-sage/20 p-6 sm:flex-row sm:items-start sm:gap-6 sm:p-8">
          <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-2xl bg-forest text-sage">
            <Icon name="badge" class="size-6" />
          </span>
          <div>
            <h3 class="font-display text-2xl text-forest">{page.privacy.title}</h3>
            <div class="mt-3 space-y-2 leading-relaxed text-forest/85">
              {page.privacy.text.map((t) => <p>{t}</p>)}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Preguntas frecuentes -->
    <section id="preguntas" class="bg-white/55 py-20 sm:py-28">
      <div class="container-page max-w-3xl">
        <div class="reveal">
          <p class="eyebrow text-terracotta-700">Preguntas frecuentes</p>
          <h2 class="mt-5 font-display text-3xl leading-tight text-forest sm:text-4xl">Resolvemos tus dudas</h2>
        </div>
        <div class="reveal mt-10 divide-y divide-forest/10 border-y border-forest/10">
          {
            page.faqs.map((f) => (
              <details class="group py-2">
                <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-3 font-medium text-forest marker:hidden [&::-webkit-details-marker]:hidden">
                  <h3>{f.q}</h3>
                  <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-sage/25 text-forest transition duration-300 group-open:rotate-45">
                    <Icon name="close" class="size-4 rotate-45" />
                  </span>
                </summary>
                <p class="pr-12 pb-4 leading-relaxed text-forest/80">{f.a}</p>
              </details>
            ))
          }
        </div>
        <p class="mt-8 text-sm text-forest/85">
          Última actualización: <time datetime={page.updated}>{fmtDate(page.updated + "T12:00:00Z")}</time>
        </p>
      </div>
    </section>

    {
      articles.length > 0 && (
        <section class="py-20 sm:py-28">
          <div class="container-page">
            <div class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
              <div>
                <p class="eyebrow text-terracotta-700">Lecturas recomendadas</p>
                <h2 class="mt-5 font-display text-3xl leading-tight text-forest sm:text-4xl">Artículos sobre la vida en pareja</h2>
              </div>
              <a href={site.social.medium} target="_blank" rel="noopener noreferrer" class="btn-outline-dark self-start md:self-auto">
                Ver todos en Medium
                <Icon name="arrow" class="size-4" />
              </a>
            </div>
            <ul class="reveal mt-10 grid gap-4 md:grid-cols-2">
              {articles.map((a) => (
                <li>
                  <a
                    href={a.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex h-full flex-col rounded-2xl border border-forest/10 bg-white/60 p-6 transition duration-300 ease-out hover:-translate-y-1 hover:shadow-xl hover:shadow-forest/10"
                  >
                    <span class="text-xs tracking-[0.2em] text-olive uppercase">
                      <time datetime={a.date}>{fmtDate(a.date)}</time> · {a.readingMinutes} min
                    </span>{" "}
                    <span class="mt-2 font-display text-xl leading-snug text-forest group-hover:text-terracotta-700">{a.title}</span>{" "}
                    <span class="mt-2 line-clamp-2 text-sm leading-relaxed text-forest/85">{a.excerpt}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <Booking message={page.whatsappMessage} />

    <!-- Otros servicios -->
    <section class="py-20 sm:py-24">
      <div class="container-page">
        <h2 class="reveal font-display text-3xl text-forest">Otros servicios</h2>
        <ul class="mt-8 grid gap-5 md:grid-cols-3">
          {
            others.map((o) => (
              <li class="reveal">
                <a
                  href={o.path}
                  class="group flex h-full flex-col rounded-3xl border border-forest/10 bg-white/60 p-7 transition duration-300 ease-out hover:-translate-y-1 hover:shadow-xl hover:shadow-forest/10"
                >
                  <span class="font-display text-2xl text-forest group-hover:text-terracotta-700">{o.title}</span>{" "}
                  <span class="mt-2 flex-1 text-sm leading-relaxed text-forest/85">{o.text}</span>
                  <span class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-forest">
                    Saber más
                    <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
  <Footer />
  <FloatingBooking href="#agenda" />
  <WhatsAppChannel />
</Layout>
