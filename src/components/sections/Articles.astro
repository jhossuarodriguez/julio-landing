---
import { Image, inferRemoteSize } from "astro:assets";
import Icon from "@/components/ui/Icon.astro";
import BgTexture from "@/components/ui/BgTexture.astro";
import markWhite from "@/assets/brand/logo-mark-white.png";
import brainDark from "@/assets/brand/brain-dark.png";
import { getArticles, ARTICLES_SHOWN } from "@/lib/medium";
import { site } from "@/config/site";

/** Cuántos artículos se muestran (el primero va destacado): ver ARTICLES_SHOWN en @/lib/medium. */
const SHOWN = ARTICLES_SHOWN;

const all = await getArticles();

// Las portadas de Medium se optimizan a AVIF con <Image />. Para eso hace falta
// conocer su tamaño; si no se puede obtener, se muestra la textura de la marca.
const articles = await Promise.all(
  all.slice(0, SHOWN).map(async (a) => {
    let cover: { src: string; width: number; height: number } | null = null;
    if (a.image) {
      try {
        const { width, height } = await inferRemoteSize(a.image);
        cover = { src: a.image, width, height };
      } catch {
        console.warn(`[medium] No se pudo leer la portada de "${a.title}"`);
      }
    }
    return { ...a, cover };
  }),
);
const [featured, ...rest] = articles;

const fmtDate = (iso: string) =>
  new Intl.DateTimeFormat("es-DO", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "America/Santo_Domingo",
  }).format(new Date(iso));
---

<section id="articulos" class="relative overflow-hidden py-24 sm:py-32" aria-labelledby="articulos-title">
  <Image
    format="avif"
    src={brainDark}
    alt=""
    width={700}
    class="pointer-events-none absolute -top-10 -left-40 w-[36rem] max-w-none opacity-[0.06]"
  />

  <div class="container-page relative">
    <div class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow text-terracotta-700">Artículos</p>
        <h2 id="articulos-title" class="mt-5 font-display text-4xl leading-tight text-forest sm:text-5xl">
          Reflexión para un bienestar en pareja
        </h2>
        <p class="mt-5 leading-relaxed font-light text-forest/85">
          Escribo sobre relaciones de pareja, sanación emocional y lo que observo en consulta, para que puedas
          comprenderte mejor.
        </p>
      </div>
      <a
        href={site.social.medium}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-outline-dark shrink-0 self-start md:self-auto"
      >
        Ver todos en Medium
        <Icon name="arrow" class="size-4" />
      </a>
    </div>

    {
      featured && (
        <a
          href={featured.url}
          target="_blank"
          rel="noopener noreferrer"
          class="reveal group mt-14 grid overflow-hidden rounded-[2rem] border border-forest/10 bg-white/70 transition duration-300 ease-out hover:shadow-2xl hover:shadow-forest/10 lg:grid-cols-2"
        >
          <div class="relative aspect-[16/10] overflow-hidden bg-forest lg:aspect-auto lg:min-h-[22rem]">
            {featured.cover ? (
              <Image
                src={featured.cover.src}
                width={featured.cover.width}
                height={featured.cover.height}
                format="avif"
                widths={[480, 720, 960]}
                sizes="(min-width: 1024px) 34rem, 92vw"
                alt=""
                class="absolute inset-0 size-full object-cover transition duration-700 group-hover:scale-[1.03]"
              />
            ) : (
              <>
                <BgTexture width={960} sizes="(min-width: 1024px) 34rem, 92vw" />
                <Image format="avif" src={markWhite} alt="" width={240} class="absolute inset-0 m-auto w-28 opacity-80" />
              </>
            )}
          </div>
          <div class="flex flex-col p-8 sm:p-10 lg:p-12">
            <p class="flex items-center gap-3 text-xs tracking-[0.2em] text-olive uppercase">
              <span class="rounded-full bg-apricot/10 px-3 py-1 tracking-[0.15em] text-terracotta-700">Más reciente</span>
              <time datetime={featured.date}>{fmtDate(featured.date)}</time>
            </p>
            <h3 class="mt-5 font-display text-3xl leading-snug text-forest group-hover:text-terracotta-700 sm:text-4xl">
              {featured.title}
            </h3>{" "}
            <p class="mt-5 leading-relaxed text-forest/85">{featured.excerpt}</p>
            <p class="mt-auto flex items-center gap-2 pt-8 text-sm font-medium text-forest">
              Leer artículo · {featured.readingMinutes} min
              <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" />
            </p>
          </div>
        </a>
      )
    }

    <div class="mt-6 grid gap-6 md:grid-cols-3">
      {
        rest.map((a) => (
          <a
            href={a.url}
            target="_blank"
            rel="noopener noreferrer"
            class="reveal group flex flex-col overflow-hidden rounded-3xl border border-forest/10 bg-white/70 transition duration-300 ease-out hover:-translate-y-1 hover:shadow-xl hover:shadow-forest/10"
          >
            <div class="relative aspect-[16/10] overflow-hidden bg-forest">
              {a.cover ? (
                <Image
                  src={a.cover.src}
                  width={a.cover.width}
                  height={a.cover.height}
                  format="avif"
                  widths={[400, 640]}
                  sizes="(min-width: 768px) 22rem, 92vw"
                  alt=""
                  class="absolute inset-0 size-full object-cover transition duration-700 group-hover:scale-[1.04]"
                />
              ) : (
                <>
                  <BgTexture width={480} sizes="(min-width: 768px) 22rem, 92vw" />
                  <Image format="avif" src={markWhite} alt="" width={200} class="absolute inset-0 m-auto w-20 opacity-80" />
                </>
              )}
            </div>
            <div class="flex flex-1 flex-col p-6">
              <p class="text-xs tracking-[0.2em] text-olive uppercase">
                <time datetime={a.date}>{fmtDate(a.date)}</time> · {a.readingMinutes} min
              </p>
              <h3 class="mt-3 font-display text-xl leading-snug text-forest group-hover:text-terracotta-700">{a.title}</h3>{" "}
              <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-forest/85">{a.excerpt}</p>
              <p class="mt-auto flex items-center gap-2 pt-5 text-sm font-medium text-forest">
                Leer en Medium
                <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" />
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
