---
import "@fontsource/gilda-display/400.css";
import "@fontsource/poppins/300.css";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@/styles/global.css";
import { site } from "@/config/site";
import { buildJsonLd } from "@/lib/schema";
import { getArticles, ARTICLES_SHOWN } from "@/lib/medium";
// Fuente de los titulares (H1 = LCP): se precarga para no retrasar el primer pintado
import gildaWoff2 from "@fontsource/gilda-display/files/gilda-display-latin-400-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  /** Imagen para compartir (ruta dentro de /public, 1200×630, JPG/PNG) */
  ogImage?: string;
  /** Excluir de buscadores (p. ej. la página 404) */
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  ogImage = "/og-image.jpg",
  noindex = false,
} = Astro.props;

// URLs absolutas: solo existen cuando `site` (SITE_URL) está configurado en astro.config.mjs
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const ogImageUrl = abs(ogImage);
const ogImageAlt = `${site.name}, ${site.role.toLowerCase()} en Santo Domingo`;

// Datos estructurados generados desde los mismos datos que muestra la página
const featuredArticles = (await getArticles()).slice(0, ARTICLES_SHOWN);
const jsonLd = buildJsonLd({
  abs,
  pageUrl: canonical ?? abs(Astro.url.pathname),
  pageTitle: title,
  imageUrl: ogImageUrl,
  articles: featuredArticles,
});
---

<!doctype html>
<html lang="es" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#3f4537" />
    <link rel="preload" href={gildaWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      document.documentElement.classList.remove("no-js");
    </script>
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-full focus:bg-linen focus:px-4 focus:py-2 focus:text-forest"
    >
      Saltar al contenido
    </a>
    <slot />

    <script>
      // Aparición suave de las secciones al entrar en pantalla
      const items = document.querySelectorAll<HTMLElement>(".reveal");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
