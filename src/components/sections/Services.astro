---
import Icon, { type IconName } from "@/components/ui/Icon.astro";
import { BOOKING_HREF, services, type ServiceSlug } from "@/config/site";

// Textos en @/config/site (compartidos con los datos estructurados); aquí solo lo visual.
const visual: Record<ServiceSlug, { icon: IconName; accent: string }> = {
  individual: { icon: "psi", accent: "bg-sage/25 text-forest" },
  pareja: { icon: "heart", accent: "bg-apricot/20 text-terracotta-700" },
  sexual: { icon: "flame", accent: "bg-terracotta/15 text-clay" },
  familiar: { icon: "users", accent: "bg-cream/70 text-olive" },
};
---

<section id="servicios" class="bg-white/55 py-24 sm:py-32">
  <div class="container-page">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow text-terracotta-700">Servicios</p>
      <h2 class="mt-5 font-display text-4xl leading-tight text-forest sm:text-5xl">¿Cómo puedo ayudarte?</h2>
      <p class="mt-5 leading-relaxed font-light text-forest/85">
        Como psicólogo clínico y psicoterapeuta familiar, de pareja y sexual, acompaño a personas, parejas y familias que
        buscan sentirse mejor y vivir con mayor bienestar emocional.
      </p>
    </div>

    <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((s) => (
          <div class="reveal group flex flex-col rounded-3xl border border-forest/10 bg-linen p-7 transition duration-300 ease-out hover:-translate-y-1 hover:shadow-xl hover:shadow-forest/10">
            <span class:list={["inline-flex size-14 items-center justify-center rounded-2xl", visual[s.slug].accent]}>
              <Icon name={visual[s.slug].icon} class="size-7" />
            </span>
            <h3 class="mt-6 font-display text-2xl text-forest">{s.title}</h3>{" "}
            <p class="mt-3 flex-1 text-sm leading-relaxed text-forest/85">{s.text}</p>
            <a
              href={s.path}
              class="mt-5 inline-flex min-h-11 items-center gap-2 self-start text-sm font-medium text-forest hover:text-terracotta-700"
            >
              Saber más<span class="sr-only"> sobre {s.title.toLowerCase()}</span>
              <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" />
            </a>
          </div>
        ))
      }
    </div>

    <div class="reveal mt-14 text-center">
      <a href={BOOKING_HREF} class="btn-outline-dark px-8">
        Agenda tu cita
        <Icon name="arrow" class="size-4" />
      </a>
    </div>
  </div>
</section>
