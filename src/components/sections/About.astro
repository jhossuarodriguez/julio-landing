---
import { Image } from "astro:assets";
import sentado from "@/assets/images/julio-sentado.png";
import jsDark from "@/assets/brand/js-dark.png";
import Icon from "@/components/ui/Icon.astro";
import { credentials, site } from "@/config/site";
---

<section id="sobre-mi" class="relative overflow-hidden py-24 sm:py-32">
  <div class="container-page grid items-center gap-16 lg:grid-cols-2">
    <div class="reveal relative order-2 lg:order-1">
      <div class="relative mx-auto max-w-md overflow-hidden rounded-[2rem] bg-sand/30">
        <Image
          format="avif"
          src={sentado}
          alt="Julio Cesar Sánchez Medina sentado, con traje azul, en un estudio luminoso"
          widths={[400, 683]}
          sizes="(min-width: 1024px) 28rem, 90vw"
          class="aspect-[4/5] h-auto w-full object-cover object-top"
        />
      </div>
      <Image
        format="avif"
        src={jsDark}
        alt=""
        width={200}
        class="absolute -top-8 right-2 hidden w-28 opacity-15 sm:block lg:-right-4"
      />
    </div>

    <div class="reveal order-1 lg:order-2">
      <p class="eyebrow text-terracotta">Sobre mí</p>
      <h2 class="mt-5 font-display text-4xl leading-tight text-forest sm:text-5xl">
        Hola, soy Julio Cesar Sánchez Medina
      </h2>
      <div class="mt-7 space-y-5 text-[1.05rem] leading-relaxed font-light text-forest/80">
        <p>
          Soy <strong class="font-medium text-forest">psicólogo clínico</strong> y psicoterapeuta familiar y de pareja
          desde {credentials.practiceSince}, con maestrías en Terapia Familiar y de Pareja y en Psicología de la Salud. Acompaño a
          personas y parejas a comprender sus emociones, fortalecer sus relaciones y vivir su sexualidad con bienestar.
        </p>
        <p>
          Trabajo desde un enfoque <strong class="font-medium text-forest">sistémico breve</strong>, orientado a la
          construcción de soluciones: una terapia cercana y humana, pero también rigurosa, basada en evidencia científica y
          adaptada a tu historia y a tu ritmo.
        </p>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        <article class="rounded-2xl border border-forest/10 bg-white/60 p-6">
          <h3 class="font-display text-2xl text-forest">Misión</h3>
          <p class="mt-3 text-sm leading-relaxed text-forest/75">
            Brindar acompañamiento psicológico profesional que permita comprender emociones, fortalecer relaciones y
            promover bienestar emocional.
          </p>
        </article>
        <article class="rounded-2xl border border-forest/10 bg-white/60 p-6">
          <h3 class="font-display text-2xl text-forest">Visión</h3>
          <p class="mt-3 text-sm leading-relaxed text-forest/75">
            Ser un referente en psicoterapia, educación emocional y salud mental en República Dominicana y
            Latinoamérica.
          </p>
        </article>
      </div>
    </div>
  </div>

  <!-- Formación y credenciales -->
  <div class="container-page mt-20">
    <div class="reveal rounded-[2rem] border border-forest/10 bg-white/60 p-7 sm:p-10">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="eyebrow text-terracotta">Formación y credenciales</p>
          <h3 class="mt-4 font-display text-3xl leading-tight text-forest sm:text-4xl">Respaldo profesional</h3>
        </div>
        <ul class="flex flex-wrap gap-3" aria-label="Habilitación profesional">
          <li class="inline-flex items-center gap-2 rounded-full bg-forest px-4 py-2 text-sm text-linen">
            <Icon name="badge" class="size-4 text-sage" />
            Exequátur <span class="font-medium">{credentials.exequatur}</span>
          </li>
          <li class="inline-flex items-center gap-2 rounded-full bg-forest px-4 py-2 text-sm text-linen">
            <Icon name="badge" class="size-4 text-sage" />
            CODOPSI <span class="font-medium">{credentials.codopsi}</span>
          </li>
        </ul>
      </div>

      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          credentials.education.map((e) => (
            <li class="flex gap-4 rounded-2xl bg-linen p-5">
              <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-sage/25 text-forest">
                <Icon name="graduation" class="size-5" />
              </span>
              <div>
                <p class="font-medium leading-snug text-forest">{e.title}</p>
                <p class="mt-1 text-sm text-forest/70">
                  {e.institution}
                  {"short" in e && e.short && ` (${e.short})`}
                  {"year" in e && e.year && ` · ${e.year}`}
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-col gap-4 border-t border-forest/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-forest/75">
          <span class="font-medium text-forest">Enfoque:</span> {credentials.approach}.
        </p>
        <a
          href={site.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-forest hover:text-terracotta"
        >
          Ver perfil en LinkedIn
          <Icon name="arrow" class="size-4" />
        </a>
      </div>
    </div>
  </div>
</section>
